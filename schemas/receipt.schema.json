{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhealth.dev/schemas/v1/receipt.schema.json",
  "title": "zHealth settlement receipt, plaintext form before encryption (spec 7.6)",
  "description": "Contains private keys. MUST be encrypted at rest. Never commit.",
  "type": "object",
  "required": ["zh_receipt", "session_started", "settled", "ledger", "root", "events", "funding_txid", "validator", "totals"],
  "properties": {
    "zh_receipt": { "const": "1" },
    "session_started": { "type": "string", "format": "date-time" },
    "settled": { "type": "string", "format": "date-time" },
    "ledger": { "enum": ["bsv-mainnet", "bsv-testnet", "bsv-regtest", "teranode-local"] },
    "root": {
      "type": "object", "required": ["xprv", "path"],
      "properties": { "xprv": { "type": "string" }, "path": { "const": "m/7348'/0'" } }
    },
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "path", "pubkey", "privkey_wif", "type", "desc", "event_hash", "txid", "status"],
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "path": { "type": "string", "pattern": "^m/7348'/0'/[0-9]+'$" },
          "pubkey": { "type": "string" },
          "privkey_wif": { "type": "string" },
          "type": { "type": "string" },
          "desc": { "type": "string" },
          "event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "txid": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "enum": ["confirmed", "pending", "failed", "dropped"] },
          "merkle_proof": { "type": "object" }
        }
      }
    },
    "funding_txid": { "type": "string" },
    "validator": { "type": "string" },
    "totals": {
      "type": "object", "required": ["validation_sat", "miner_sat"],
      "properties": { "validation_sat": { "type": "integer" }, "miner_sat": { "type": "integer" } }
    }
  }
}
