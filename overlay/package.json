{
  "name": "@zhealth/overlay",
  "version": "0.1.0",
  "description": "zHealth overlay service: tm_zhealth topic manager and ls_zhealth lookup service (BRC-22 / BRC-24)",
  "type": "module",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "npm run build && node dist/src/dev-server.js",
    "start": "node dist/src/node.js"
  },
  "dependencies": {
    "@bsv/overlay": "^2.7.0",
    "@bsv/sdk": "^4.1.0",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7"
  },
  "optionalDependencies": {
    "@bsv/overlay-express": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
